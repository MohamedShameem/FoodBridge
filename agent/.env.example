AWS_REGION=us-west-2
# Fast primary model. Store the real key only in a local/deployment secret store.
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CREDENTIAL_PROVIDER_NAME=foodbridge-groq

# Amazon Bedrock remains the final AWS fallback.
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0

# Secondary GLM fallback.
GLM_API_KEY=
GLM_MODEL_ID=glm-5.1
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
# In AgentCore, store the key in Identity under this provider name instead.
GLM_CREDENTIAL_PROVIDER_NAME=foodbridge-glm
